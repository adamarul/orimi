## True when p stands on clean ground inside a hollow (a causeway, island, ramp or the plateau).
static func is_safe(p: Vector3, margin: float = 0.0) -> bool:
	var q := Vector2(p.x, p.z)
	for d: Vector3 in SAFE_DISCS:
		if q.distance_to(Vector2(d.x, d.y)) < d.z + margin:
			return true
	for line: Dictionary in SAFE_LINES:
		if polyline_distance(q, line["points"]) < float(line["half_width"]) + margin:
			return true
	return false


## The hollow whose rim p lies inside, or &"".
static func hollow_at(p: Vector3) -> StringName:
	for key: StringName in HOLLOWS:
		var h: Dictionary = HOLLOWS[key]
		var c: Vector3 = h["center"]
		if Vector2(p.x - c.x, p.z - c.z).length() < float(h["rim_radius"]):
			return key
	return &""


## Ground that keeps you out: inside a hollow's rim and below the plain, and not safe.
static func is_kept_out(p: Vector3) -> bool:
	var key := hollow_at(p)
	if key == &"":
		return false
	return not is_safe(p)


static func polyline_distance(q: Vector2, pts: Array) -> float:
	var best := INF
	for i in pts.size() - 1:
		var a: Vector2 = pts[i]
		var b: Vector2 = pts[i + 1]
		var ab := b - a
		var t := clampf((q - a).dot(ab) / maxf(ab.length_squared(), 0.0001), 0.0, 1.0)
		best = minf(best, q.distance_to(a + ab * t))
	return best
