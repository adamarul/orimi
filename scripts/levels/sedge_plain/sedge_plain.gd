extends Level
## Sedge Plain, Level 3. The scene is generated by tools/levels/sedge_plain/make_level.py from the
## same layout as the terrain. This script adds what is built in code (sedge, the wood, mist), takes
## up the map leaves (their Pickups set leaf_1..3; leaves_two and leaves_all switch what
## Tamsin says on the rim), records which of her conversations Orimi has heard (talked_<key>), and
## runs the finale: the Mere is restored from the Knoll's sapling, then
## the colour sweeps Kettle Hollow and Ladle Hollow. The LevelExit on the brook ends the level. Owner: l3.

const Scenery := preload("res://scripts/levels/sedge_plain/sedge_scenery.gd")
const SWEEP := [&"Zone_east", &"Zone_west"]
const SAPLING_SCALE := 1.8
const AUDIO_DIR := "res://audio/levels/sedge_plain/"


func _ready() -> void:
	super()
	Audio.register_music(&"sedge_plain_cursed", AUDIO_DIR + "sedge_plain_cursed.ogg")
	Audio.register_music(&"sedge_plain_restored", AUDIO_DIR + "sedge_plain_restored.ogg")
	Audio.set_level_music(&"sedge_plain_cursed", &"sedge_plain_restored", false)


func _exit_tree() -> void:
	Audio.set_level_music(&"")
	super()


func _build(_progress: Callable) -> void:
	var sky := find_child("SharedSky", true, false)
	if sky != null:
		sky.set(&"dome_radius", 420.0)
	Scenery.build_mist(self)
	Scenery.build_foliage(self, int(Boot.opt("foliage", "700")))
	Scenery.build_wood(self)
	var sapling := node("Sapling_mere")
	if sapling != null:
		for c: Node in sapling.get_children():
			if c is Node3D and not c is CollisionShape3D:
				(c as Node3D).scale *= SAPLING_SCALE
	flag_changed.connect(_on_flag)
	for k in 3:
		var id := "leaf_%d" % (k + 1)
		var leaf := node("Leaf_%d" % (k + 1)) as Pickup
		if leaf != null:
			leaf.picked.connect(func() -> void:
				if is_instance_valid(Game.main) and has_lines(id):
					Game.main.talk.run(lines(id)))
	var rim := node("Tamsin_Rim") as Person
	if rim != null:
		rim.talked.connect(func(key: String) -> void: set_flag(StringName("talked_" + key.trim_suffix("_again"))))


func _on_flag(flag: StringName, on: bool) -> void:
	if not (on and String(flag).begins_with("leaf_")):
		return
	var taken := [&"leaf_1", &"leaf_2", &"leaf_3"].filter(func(f: StringName) -> bool: return get_flag(f)).size()
	if taken >= 2:
		set_flag(&"leaves_two")
	if taken == 3:
		set_flag(&"leaves_all")


func run_finale(zone: CursedZone) -> void:
	zone.restore()
	await get_tree().create_timer(CursedZone.RESTORE_TIME * 0.6, false).timeout
	for zone_name: StringName in SWEEP:
		var z := node(String(zone_name)) as CursedZone
		if z != null:
			z.restore()
			await get_tree().create_timer(CursedZone.RESTORE_TIME * 0.6, false).timeout
	CurseField.set_valley_gloom(0.0, 3.0)
