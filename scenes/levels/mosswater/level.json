{
	"spawn_facing": "M_DarkHollow",
	"complete_on_objectives": false,
	"objectives": [
		{
			"text": "Find the charcoal-burner in the dark",
			"flag": "talked_fenn"
		},
		{
			"text": "Blow the soot out of the paddle-wheel",
			"flag": "wheel_freed"
		},
		{
			"text": "Bloom the lily buds across the middle pond",
			"flags": [
				"lily_1_open",
				"lily_2_open",
				"lily_3_open"
			]
		},
		{
			"text": "Tie the fallen log back across the weir",
			"flag": "tied_log"
		},
		{
			"text": "Climb the gully to the dam",
			"flags": [
				"thorns_cut",
				"soot_cleared",
				"tied_gap"
			]
		},
		{
			"text": "Win the fight on the dam",
			"flag": "fight_dam"
		},
		{
			"text": "Bloom the old willow",
			"flag": "restored_spring"
		},
		{
			"text": "Board Pell's raft on Willow Pool",
			"flag": "exit_reached"
		}
	],
	"lines": {
		"pell": [
			{
				"who": "Pell",
				"text": "Mosswater Wood. The stream ought to be loud here."
			},
			{
				"who": "Pell",
				"text": "It isn't."
			},
			{
				"who": "Pell",
				"text": "I lit the first *lantern-fruit* for you. That's all my flint's good for."
			},
			{
				"who": "Pell",
				"text": "Bring the water back and we can go on upriver. I'll mind the raft."
			}
		],
		"pell_again": [
			{
				"who": "Pell",
				"text": "Mind the dark. Things sit in it."
			},
			{
				"who": "Pell",
				"text": "And don't fall in anything. I only brought one towel."
			}
		],
		"pell_leaves": [
			{
				"who": "Pell",
				"text": "That's water! Real water, going the right way!"
			},
			{
				"who": "Pell",
				"text": "Get on. Before it changes its mind."
			}
		],
		"fenn": [
			{
				"text": "Stop there. In my light or out of it. Not on the edge."
			},
			{
				"text": "...A paper fox. Huh."
			},
			{
				"text": "Fenn. I burn charcoal. Burned. Nobody's come for any in a long while."
			},
			{
				"text": "You came up the river, so you've seen the ponds. Black as my hands."
			},
			{
				"text": "The *wheel* at the bottom pond is choked with soot. If it turned, the pond would breathe again."
			},
			{
				"text": "I'd clear it myself. Soot doesn't care for shovels."
			}
		],
		"fenn_again": [
			{
				"text": "This fire hasn't gone out in a year. I think it's the only reason I'm still me."
			},
			{
				"text": "Keep a light near you. The dark here isn't empty."
			}
		],
		"fenn_wheel": [
			{
				"who": "Fenn",
				"text": "Hear that? That's the bottom pond, talking again."
			},
			{
				"who": "Fenn",
				"text": "...Thank you. I'm out of practice at saying it."
			},
			{
				"who": "Fenn",
				"text": "The middle pond's up the bank. Climb the shelves on the *stair tree*. They held me and a sack of charcoal."
			},
			{
				"who": "Fenn",
				"text": "The lilies up there shut tight when the water stopped. Show them something round and bright. They'll think it's morning."
			},
			{
				"who": "Fenn",
				"text": "I'll go round by the goat path and meet you up top. You'd fit on it. You wouldn't like it."
			}
		],
		"fenn_call": [
			{
				"who": "Fenn",
				"text": "Over here! Keep out of the water. It's deep, and it's wrong."
			},
			{
				"who": "Fenn",
				"text": "Mind the flitters over the island. Soot with wings. They can't abide a draught."
			}
		],
		"fenn_log": [
			{
				"who": "Fenn",
				"text": "That log was my bridge. Now it's a cork in the weir."
			},
			{
				"who": "Fenn",
				"text": "There's a post on your side and one on mine. You'd want a long rope, mind."
			}
		],
		"fenn_tied": [
			{
				"who": "Fenn",
				"text": "You made a rope out of ink. I'm not going to ask."
			},
			{
				"who": "Fenn",
				"text": "Hear the weir? That's two ponds talking."
			},
			{
				"who": "Fenn",
				"text": "Come over. I owe you a story, and I'd rather tell it in the light."
			}
		],
		"fenn_ledge": [
			{
				"text": "There was a man from the head of the river. The *Ink-maker*, folk called him."
			},
			{
				"text": "Most people buy a sack of charcoal. He bought the whole winter's burn. Every winter."
			},
			{
				"text": "Last time, he wanted it blacker. I asked him how black."
			},
			{
				"text": "He said, a black you could fall into."
			},
			{
				"text": "I should have asked what he wanted it for."
			}
		],
		"fenn_ledge_again": [
			{
				"text": "The gully's the only way up to the dam."
			},
			{
				"text": "Thorns at the bottom, dark in the middle, soot at the top. And a gap with no bridge. Bring everything you've got."
			}
		],
		"fenn_willow": [
			{
				"text": "You came up the gully. I took the long way. I'm not ashamed."
			},
			{
				"text": "That's the old *willow*. Its roots hold the spring. Open, or shut. Right now, shut."
			},
			{
				"text": "My mother tied that cord round it, for luck. It's been a thin year for luck."
			}
		],
		"fenn_willow_again": [
			{
				"text": "*Bloom* the willow. I'll stand back. I've had enough surprises for one year."
			}
		],
		"fenn_end": [
			{
				"who": "Fenn",
				"text": "Listen to that."
			},
			{
				"who": "Fenn",
				"text": "...I'd forgotten it was this loud."
			}
		],
		"fenn_farewell": [
			{
				"text": "If you meet the Ink-maker up there, tell him the burner says the ponds are moving."
			},
			{
				"text": "He'll know what I mean. Or he won't. Either way, tell him."
			}
		],
		"verse_1": [
			{
				"who": "",
				"text": "I bought my black from the burner by the ponds."
			},
			{
				"who": "",
				"text": "Willow wood, burned slow, a whole winter's sleep."
			},
			{
				"who": "",
				"text": "He said, that's dark enough for any letter."
			},
			{
				"who": "",
				"text": "I said, not for the one I mean to write."
			}
		],
		"verse_2": [
			{
				"who": "",
				"text": "I cut a willow switch here for my first brush."
			},
			{
				"who": "",
				"text": "The tree didn't mind. It had a thousand more."
			},
			{
				"who": "",
				"text": "I came back for water when my ink ran thick."
			},
			{
				"who": "",
				"text": "The spring always gave. I never once said thank you."
			}
		],
		"bead": [
			{
				"who": "",
				"text": "The ponds remember their colour. *Water indigo* joins the cord."
			}
		]
	},
