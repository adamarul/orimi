	"complete_on_objectives": false,
	"objectives": [
		{
			"text": "Tie a rope across the Seam",
			"flag": "tied_bridge_1"
		},
		{
			"text": "Find Tamsin's first map leaf on the Mere's rim",
			"flag": "leaf_1"
		},
		{
			"text": "Fetch the leaf from Kettle Hollow",
			"flag": "leaf_2"
		},
		{
			"text": "Fetch the leaf from Ladle Hollow",
			"flag": "leaf_3"
		},
		{
			"text": "Bring Tamsin all three leaves",
			"flag": "talked_tamsin_map"
		},
		{
			"text": "Follow the old road through the Mere",
			"flag": "tied_mere_gap"
		},
		{
			"text": "Wake the sapling on the Knoll",
			"flag": "restored_mere"
		}
	],
	"lines": {
		"pell_arrival": [
			{
				"who": "Pell",
				"text": "Sedge Plain. Mind the holes. They bite."
			},
			{
				"who": "Pell",
				"text": "I'll pole round through the trees and wait where the brook comes out of the *wood*."
			},
			{
				"who": "Pell",
				"text": "If you hear someone shouting at the wind, that's the mapmaker. She's harmless. Mostly."
			}
		],
		"pell_arrival_again": [
			{
				"who": "Pell",
				"text": "Go on. I'll be at the brook by the *wood*. Ears ready."
			}
		],
		"tamsin_meet": [
			{
				"text": "Oh! A fox. A paper fox. Are you lost as well?"
			},
			{
				"text": "Don't answer that. Nobody out here answers."
			},
			{
				"text": "I'm Tamsin. I map this plain. Mapped it. Was mapping it."
			},
			{
				"text": "Then the black came up in the low places, and the wind took my map clean off the frame."
			},
			{
				"text": "Three leaves, and every one blew into a hollow. Of course it did."
			},
			{
				"text": "The first went north, past the *Leaning Stones*, toward the gully. The *Seam*, I call it."
			},
			{
				"text": "Bring it back and I'll draw you. From the good side."
			}
		],
		"tamsin_rim_early": [
			{
				"text": "The leaf went down by the Mere's rim, just east of here. Bring it and I'll show you where we are."
			}
		],
		"tamsin_meet_again": [
			{
				"text": "North, past the stones. The leaf is the one thing out there that isn't sedge."
			}
		],
		"verse_1": [
			{
				"text": "I carried soot across this plain each spring."
			},
			{
				"text": "Where the ground split, I strung a rope from post to post."
			},
			{
				"text": "One straight line and two good posts make a bridge."
			},
			{
				"text": "I made a thousand. I never made one home."
			}
		],
		"leaf_1": [
			{
				"who": "",
				"text": "A leaf of Tamsin's map: most of the plain, and a hole where the middle should be."
			}
		],
		"tamsin_rim": [
			{
				"text": "You tied the bridge! I walked over it with my eyes shut. Both of them."
			},
			{
				"text": "That's my first leaf. Look: there's the *Mere*, and the Knoll in the middle of it."
			},
			{
				"text": "There used to be a road out to the Knoll. My map knows where. My map is in three pieces."
			},
			{
				"text": "The second leaf is east, out on the island in *Kettle Hollow*. The causeway's under soot."
			},
			{
				"text": "Soot blows away, I'm told. Do you blow?"
			}
		],
		"tamsin_rim_again": [
			{
				"text": "East, to Kettle Hollow. Blow the soot off the causeway and walk out to the island."
			}
		],
		"spur_dead_end": [
			{
				"who": "",
				"text": "The old road stops here, in the black. This isn't the way."
			}
		],
		"leaf_2": [
			{
				"who": "",
				"text": "The second leaf: a road leaves the rim for the Knoll, then runs off the edge of the page."
			}
		],
		"tamsin_two_leaves": [
			{
				"text": "Kettle Hollow! I named it. It whistles when the wind's in the south."
			},
			{
				"text": "The last leaf went west, back over the gully, into *Ladle Hollow*. Yes, I named that one too."
			}
		],
		"leaf_3": [
			{
				"who": "",
				"text": "The third leaf: two bends, a gap, and the Knoll."
			}
		],
		"tamsin_map": [
			{
				"text": "All three! Hold still, I need your nose to pin the corner."
			},
			{
				"text": "There. The old road goes in by the *leaning post*, bends twice, and jumps a gap before the Knoll."
			},
			{
				"text": "The soot at the start is thick. Blow hard. Then *tie* the gap the way you tied the gully."
			},
			{
				"text": "I'd come along, but someone has to hold the map. Also I'm scared of the black. Mostly the second thing."
			}
		],
		"tamsin_map_again": [
			{
				"text": "In by the leaning post, two bends, tie the gap. I'll be right here. Holding the map. Bravely."
			}
		],
		"verse_2": [
			{
				"text": "I boiled this sedge for green when I was young."
			},
			{
				"text": "The green ran out of every pot I filled."
			},
			{
				"text": "So I began to grind a black to keep it in."
			},
			{
				"text": "The plain kept its green without me. I should have asked it how."
			}
		],
		"tamsin_after": [
			{
				"text": "Look at it. Every hollow green right to the bottom."
			},
			{
				"text": "I finished the map. Here's the river, all the way up past the *wood*."
			},
			{
				"text": "And here's the mountain, and here is... nothing. I have never once drawn nothing."
			},
			{
				"text": "Somebody up there makes ink. Lots of it. I could smell it on the wind before the black came."
			},
			{
				"text": "Take the path north-west, down to the brook. Your ferry child is waiting there. Loudly."
			}
		],
		"tamsin_after_again": [
			{
				"text": "North-west, through the trees. Come back and I'll draw you. I did say the good side. I meant it."
			}
		],
		"pell_exit": [
			{
				"who": "Pell",
				"text": "There you are. The whole plain went green behind you. I saw it from the water."
			},
			{
				"who": "Pell",
				"text": "In you get. It's dark under those trees, so hold on to your ears."
			}
		]
	},
	"raft": {
		"talk": "pell_exit",
		"card": "Pell poles the raft north-west, under the trees of Mosswater Wood."
	},
	"end_text": "[font_size=34]The plain is on the map again.[/font_size]\n\nTamsin's three leaves are one sheet, the Mere runs green under the Knoll, and the brook carries Pell on towards Mosswater Wood.",
