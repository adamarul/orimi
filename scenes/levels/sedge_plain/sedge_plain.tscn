[node name="SedgePlain" type="Node3D"]
script = ExtResource("level")
level_id = &"sedge_plain"
display_name = "Sedge Plain"
chapter = "The Mapmaker's Road"
intro_text = "A wide plain of sedge and standing stones. The black has come up in the low places, and the wind took a mapmaker's map.

Find her leaves, cross the Seam, and wake the sapling on the Knoll."
title_marker = "M_Knoll"

