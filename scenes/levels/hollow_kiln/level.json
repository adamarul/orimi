	"lines": {
		"pell": [
			{
				"text": "End of the river. Well. End of the bit I'll pole."
			},
			{
				"text": "That's the *kiln* up there, with the round hat on. All the black came down from it."
			},
			{
				"text": "I'll mind the raft. Shout if you need me. I won't hear you, but shout."
			}
		],
		"pell_again": [
			{
				"text": "The gate's tied with ink. You're good with knots. Well, you cut them."
			}
		],
		"verse_1": [
			{
				"who": "Verse-stone",
				"text": "I came up the river with a jar of black"
			},
			{
				"who": "Verse-stone",
				"text": "and a fear of every colour going pale."
			},
			{
				"who": "Verse-stone",
				"text": "The mountain gave me clay, the stream gave water."
			},
			{
				"who": "Verse-stone",
				"text": "I built a kiln to make a black that stays."
			}
		],
		"gate_look": [
			{
				"who": "",
				"text": "The gate is tied shut with a cord of wet *ink*. The two braziers beside it are cold, their wicks still dry."
			}
		],
		"gate_half": [
			{
				"who": "",
				"text": "The gate shivers in its frame, and holds."
			}
		],
		"wenna_faded": [
			{
				"who": "",
				"text": "A woman by the woodpile, as grey as the ash in her bucket. She does not look up."
			}
		],
		"wenna": [
			{
				"text": "Oh. The logs are *brown*. I'd forgotten logs were brown."
			},
			{
				"text": "I'm Wenna. I kept his fires for twenty winters, till he sent me down to the yard and barred the hall."
			},
			{
				"text": "The hall floor's gone bad. Keep to the *boards*. Where the soot's buried them, the *bellows* still blow."
			},
			{
				"text": "The back door hangs on a counterweight. He always *tied* it off to the post. And mind the flue after. It fills."
			}
		],
		"wenna_again": [
			{
				"text": "He wasn't unkind. He was frightened of *grey*."
			},
			{
				"text": "He'd hold a page up to the window every morning, to see if it had faded in the night."
			}
		],
		"hall_look": [
			{
				"who": "",
				"text": "Racks of paper, every sheet grey. The floor between the boards *smoulders* with ink."
			}
		],
		"verse_2": [
			{
				"who": "Verse-stone",
				"text": "Paper fades. The dyer's blue goes grey by spring."
			},
			{
				"who": "Verse-stone",
				"text": "I hung a thousand sheets to dry and watched them."
			},
			{
				"who": "Verse-stone",
				"text": "The ones I inked the deepest held the longest."
			},
			{
				"who": "Verse-stone",
				"text": "So I inked deeper. Then I inked the ink."
			}
		],
		"counterweight_look": [
			{
				"who": "",
				"text": "The door's weight hangs from a beam overhead. Below it stands a *post*, worn smooth by rope."
			}
		],
		"flue_rise": [
			{
				"who": "",
				"text": "Somewhere below, the ink begins to *rise*."
			}
		],
		"flue_dark": [
			{
				"who": "",
				"text": "Too dark to see the next ledge. The lamps on the walls still have their *wicks*."
			}
		],
		"verse_3": [
			{
				"who": "Verse-stone",
				"text": "The vat drank lamp-black, charcoal, soot and night."
			},
			{
				"who": "Verse-stone",
				"text": "It grew too heavy to stir, and then to lift."
			},
			{
				"who": "Verse-stone",
				"text": "One morning something in the dark looked back."
			},
			{
				"who": "Verse-stone",
				"text": "I told it: keep. It was the only word it learned."
			}
		],
		"dregs_wakes": [
			{
				"who": "",
				"text": "Something in the vat breathes out *soot*."
			}
		],
		"dregs_hint_veil": [
			{
				"who": "",
				"text": "The soot round it *billows* like a curtain in a draught."
			}
		],
		"dregs_hint_arms": [
			{
				"who": "",
				"text": "Each arm lies *still* a moment after it strikes."
			}
		],
		"dregs_hint_chains": [
			{
				"who": "",
				"text": "Each of the two *pillars* carries an iron ring."
			}
		],
		"dregs_hint_mouths": [
			{
				"who": "",
				"text": "Three kiln mouths, cold for years. Their *wicks* are still dry."
			}
		],
		"vat_crack": [
			{
				"who": "",
				"text": "The vat is cracked from rim to foot. Something *green* waits in the crack."
			}
		],
		"verse_4": [
			{
				"who": "Verse-stone",
				"text": "It kept the river, the reeds, the faces. It kept them still."
			},
			{
				"who": "Verse-stone",
				"text": "Nothing faded, because nothing moved."
			},
			{
				"who": "Verse-stone",
				"text": "I was wrong about what stays. Colour stays by coming back."
			},
			{
				"who": "Verse-stone",
				"text": "Let the river run. Let it fade, and bloom."
			}
		],
		"ending": [
			{
				"who": "Pell",
				"text": "That flue is a lot of stairs."
			},
			{
				"who": "Pell",
				"text": "So that's where all the colour went. Back where it was."
			},
			{
				"who": "Pell",
				"text": "There's more river above the mountain, you know."
			}
		]
	},
	"raft": {
