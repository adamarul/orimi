	"lines": {
		"mender": [
			{
				"text": "Ah, the paper fox. Thorns have grown over the path again."
			},
			{
				"text": "Take up your brush and cut straight across them with a *Slash*."
			},
			{
				"text": "Beyond them a knot of black cord is drifting. Touch it and it will close a ring round you."
			}
		],
		"mender_again": [
			{
				"text": "The grove is past the knot. A *Bloom* round the sapling wakes it."
			}
		],
		"greyed_faded": [
			{
				"who": "",
				"text": "Sorrel stands grey and still, like a figure nobody has painted yet."
			}
		],
		"greyed": [
			{
				"text": "Oh! The grove is green again. I could not move while it was grey."
			},
			{
				"text": "Thank you, little fox. Tell the Mender I am awake."
			}
		],
		"verse_stone": [
			{
				"text": "This stone was set here to show how a verse-stone speaks."
			},
			{
				"text": "Bloom it and its lines appear, one at a time."
			},
			{
				"text": "Key words come in the *accent colour*."
			},
			{
				"text": "When the last line ends, the stone sets its flag."
			}
		],
		"mender_bark": [
			{
				"text": "Over here, little fox!"
			}
		],
		"mender_after": [
			{
				"text": "The grove is green again. Sorrel will be glad."
			}
		],
		"greyed_wakes": [
			{
				"text": "Oh! I can move again!"
			}
		],
		"pell": [
			{
				"text": "Raft's tied up at the bank. Hop on when you're ready."
			}
		],
		"pell_arrives": [
			{
				"who": "Pell",
				"text": "Here we are. I'll wait by the raft."
			}
		],
		"pell_leaves": [
			{
				"who": "Pell",
				"text": "All aboard, little fox. Mind the edge."
			}
		],
		"leaf_found": [
			{
				"text": "A leaf of somebody's map, folded small. Pell will know whose."
			}
		]
	},
