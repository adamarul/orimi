[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_probe"]
script/source = "extends Node3D
## Walkability probe for the valley terrain: ray-casts the imported collision along routes and
## prints the steepest floor normal on each, against the player's floor_max_angle (48 deg).
##   \"$GODOT\" --headless --path . -- scene=res://scenes/dev/assets_terrain_probe.tscn

const ROUTES := {
	\"rise_west_ramp\": [Vector2(-9.0, -21.0), Vector2(-11.0, -37.5)],
	\"west_strip_to_ramp_foot\": [Vector2(-19.5, -44.0), Vector2(-19.0, -33.0), Vector2(-14.0, -24.5), Vector2(-9.5, -20.5)],
	\"gate_b_shore_bank\": [Vector2(1.8, 3.0), Vector2(2.6, 4.8), Vector2(5.2, 5.4)],
	\"gate_b_ramp\": [Vector2(4.0, 8.6), Vector2(8.3, -1.3)],
	\"terrace_ramp_to_rise\": [Vector2(7.0, -22.0), Vector2(3.0, -31.0)],
}


func _ready() -> void:
	add_child((load(\"res://scenes/models/valley_terrain.tscn\") as PackedScene).instantiate())
	for i in 3:
		await get_tree().physics_frame
	var space := get_world_3d().direct_space_state
	var fails := 0
	for route_name in ROUTES:
		var pts: Array = ROUTES[route_name]
		var worst := 0.0
		var worst_at := Vector3.ZERO
		var heights: Array[float] = []
		for k in range(pts.size() - 1):
			var a: Vector2 = pts[k]
			var b: Vector2 = pts[k + 1]
			var n := int(ceil(a.distance_to(b) / 0.25))
			for s in n + 1:
				var p := a.lerp(b, float(s) / n)
				var q := PhysicsRayQueryParameters3D.create(Vector3(p.x, 30, p.y), Vector3(p.x, -10, p.y))
				var hit := space.intersect_ray(q)
				if hit.is_empty():
					continue
				var ang := rad_to_deg(acos(clampf((hit.normal as Vector3).dot(Vector3.UP), -1.0, 1.0)))
				if hit.position.y > -0.35 and ang > worst:
					worst = ang
					worst_at = hit.position
				if s % 8 == 0:
					heights.append(snappedf(hit.position.y, 0.1))
		var ok := worst < 48.0
		fails += 0 if ok else 1
		print(\"ORIMI_TERRAIN_PROBE %s %s steepest %.1f deg at %s heights %s\" % [\"ok  \" if ok else \"FAIL\", route_name, worst, worst_at.snappedf(0.1), heights])
	print(\"ORIMI_TERRAIN_PROBE %s fails=%d\" % [\"PASS\" if fails == 0 else \"FAIL\", fails])
	get_tree().quit(0 if fails == 0 else 1)
"

[node name="AssetsTerrainProbe" type="Node3D"]
script = SubResource("GDScript_probe")
